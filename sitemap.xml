---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages = site.pages | where_exp: "p", "p.url != nil" | where_exp: "p", "p.url != '/404.html'" | where_exp: "p", "p.url != '/assets/css/style.css'" %}
{% assign sections = pages | where_exp: "p", "p.url == '/' or p.url == '/tools/' or p.url == '/resources/' or p.url == '/writeups/' or p.url == '/vulnerabilities/' or p.url == '/vulnerabilities/research/' or p.url == '/vulnerabilities/CVE/' or p.url == '/vulnerabilities/vendor-labs/' or p.url == '/vulnerabilities/vendor-labs/citrix/' or p.url == '/vulnerabilities/vendor-labs/fortinet/'" | sort: "url" %}
{% assign articles = pages | where_exp: "p", "p.category == 'vulnerability'" | sort: "date" | reverse %}
{% assign other = pages | where_exp: "p", "p.category != 'vulnerability' and p.url != '/' and p.url != '/tools/' and p.url != '/resources/' and p.url != '/writeups/' and p.url != '/vulnerabilities/' and p.url != '/vulnerabilities/research/' and p.url != '/vulnerabilities/CVE/' and p.url != '/vulnerabilities/vendor-labs/' and p.url != '/vulnerabilities/vendor-labs/citrix/' and p.url != '/vulnerabilities/vendor-labs/fortinet/'" | sort: "url" %}

  <!-- 固定页面 -->
{% for page in sections %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>{% if page.url == '/' %}1.0{% elsif page.url contains '/vulnerabilities/' %}0.8{% else %}0.6{% endif %}</priority>
  </url>
{% endfor %}

  <!-- 技术文章 -->
{% for page in articles %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    <lastmod>{{ page.date | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{% endfor %}

  <!-- 其他页面 -->
{% for page in other %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
{% endfor %}
</urlset>